# Git
.git
.gitignore
.gitattributes

# Python bytecode and caches
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# Virtualenvs
venv
env
.venv
*/venv
*/venv/*

# Node
node_modules
*/node_modules
npm-debug.log
yarn-error.log
frontend/dist

# Android / Capacitor build outputs (not used in Docker)
frontend/android/.gradle
frontend/android/app/build
frontend/android/build
frontend/android/.idea
frontend/android/local.properties
jdk-21.0.10+7
.android-sdk

# IDE
.vscode
.idea
*.swp
*.swo

# Secrets — defensive: cover all .env variants, keep only the example
backend/.env
backend/.env.*
!backend/.env.example
.env
.env.*
*.key
*.pem
credentials.json
secrets.json
service_account*.json

# Runtime state
backend/logs
backend/uploads
uploads

# ChromaDB backups inside packs (dead weight)
packs/*/chroma_db_backup_*

# Demo artifacts — entire folder is unused when DEMO_MODE=false (which is
# how Docker runs). demo_replay.py only reads script.json when demo_mode is
# true, so the image doesn't need any of it.
demo/

# Tests
backend/tests

# Docs directory (scoped — does not affect pack README/SOURCES)
docs/

# Large binaries
*.mp4
*.mov
*.apk

# OS
.DS_Store
Thumbs.db
