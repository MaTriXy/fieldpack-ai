# FieldPack AI — Environment Variables
# Copy this to .env and fill in your values

# Google AI Studio (Phase 1 — online LLM)
GOOGLE_AI_STUDIO_API_KEY=your_api_key_here

# Ollama (Phase 2 — offline LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4-e4b:q8

# Google AI Studio model names
ONLINE_MODEL_LARGE=gemma-4-31b-it
ONLINE_MODEL_RESEARCH=gemma-4-26b-a4b-it

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths
KNOWLEDGE_PACK_DIR=../packs
UPLOAD_DIR=../uploads

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
