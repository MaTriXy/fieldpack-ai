# FieldPack AI — Environment Variables
# Copy this to .env and fill in your values

# Google AI Studio (Phase 1 — online LLM)
GOOGLE_AI_STUDIO_API_KEY=your_api_key_here

# Ollama (Phase 2 — offline LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
# For remote Ollama via Colab GPU tunnel (leave empty for local):
# OLLAMA_TUNNEL_TOKEN=

# Edge inference tuning
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=-1

# Ollama server-level vars (set BEFORE starting ollama serve):
#   OLLAMA_KV_CACHE_TYPE=q4_0    # 4-bit KV cache — halves context memory
#   OLLAMA_FLASH_ATTENTION=1     # Flash attention — faster on supported HW
#   OLLAMA_NUM_PARALLEL=1        # Single request — saves RAM on edge devices
#   OLLAMA_MAX_LOADED_MODELS=1   # One model at a time — fits in 4 GB
#
# Memory budget (E2B q4_K_M, num_ctx=4096):
#   Model weights  ~1.8 GB
#   KV cache       ~0.5 GB (q4_0) or ~1.0 GB (fp16)
#   Overhead       ~0.3 GB
#   Total          ~2.6-3.1 GB — fits in 4 GB device

# Google AI Studio model names
ONLINE_MODEL_LARGE=gemma-4-31b-it
ONLINE_MODEL_RESEARCH=gemma-4-26b-a4b-it

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths
KNOWLEDGE_PACK_DIR=../packs
UPLOAD_DIR=../uploads

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
